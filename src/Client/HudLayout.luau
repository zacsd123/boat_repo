--!strict
-- 화면 배치의 숫자(픽셀). 버튼과 수위 막대가 같은 자리를 두고 겹치지 않도록 한 곳에서 정한다(S11-1).
-- 규칙의 수치가 아니라 모양의 값이라 Config에 두지 않는다. 디자인(S14)에서 다시 정한다.
-- 버튼은 화면 오른쪽 아래, 수위 막대는 그 바로 위 같은 세로줄이다.

local HudLayout = {
	EDGE = 24, -- 화면 가장자리에서 버튼까지, 그리고 막대 위 끝에서 화면 위까지
	BUTTON_SIZE = 96, -- 둥근 버튼의 지름
	BAR_WIDTH = 28, -- 수위 막대의 폭
	BAR_MAX_HEIGHT = 220, -- 수위 막대의 가장 큰 높이. 화면이 낮으면 이보다 짧아진다
	BAR_MIN_HEIGHT = 80, -- 화면이 아주 낮아도 막대가 읽히는 가장 작은 높이
	GAP = 16, -- 버튼 위 끝과 막대 아래 끝 사이
	MINI_BELL_SIZE = 14, -- 수위 막대 옆 작은 종 하나의 지름(S14)
	MINI_BELL_GAP = 6, -- 작은 종 사이, 그리고 작은 종과 막대 사이
}

return table.freeze(HudLayout)
